# Neon: console.neon.tech -> your project -> Connect -> copy the POOLED connection string (host contains "-pooler")
DATABASE_URL=
# AI provider (server-side only, via Groq)
AI_PROVIDER=groq
AI_API_KEY=          # Groq key from console.groq.com
AI_MODEL=llama-3.3-70b-versatile
# Google Cloud Console -> Credentials -> OAuth client (redirect: http://localhost:8787/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string: openssl rand -hex 32
SESSION_SECRET=
PORT=8787
# Load & cost controls (optional; defaults shown)
MAX_JOBS=4
MAX_QUEUED=300
MAX_INFLIGHT_MB=300
AI_MAX_CONCURRENCY=5
AI_CALL_TIMEOUT_MS=15000
ANALYZE_DEADLINE_MS=20000
MAX_CHUNKS_QUICK=4
MAX_CHUNKS_DEEP=8
QUICK_BUDGET_TOKENS=40000
DEEP_BUDGET_TOKENS=250000
# Set to 1 when behind a reverse proxy / load balancer
TRUST_PROXY=
APP_URL=http://localhost:5173
